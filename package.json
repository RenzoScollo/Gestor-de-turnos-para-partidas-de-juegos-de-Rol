{
  "name": "gestor-turnos-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "schema:create": "ts-node ./node_modules/@mikro-orm/cli/cli.js schema:create --run",
    "schema:update": "ts-node ./node_modules/@mikro-orm/cli/cli.js schema:update --run",
    "schema:dump": "ts-node src/valida-entities.ts",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest app.integration"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.16",
    "@mikro-orm/mysql": "^6.6.16",
    "@types/express": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.6",
    "prompt-sync": "^4.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/prompt-sync": "^4.2.3",
    "@types/react": "^19.2.17",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "mikro-orm": {
    "useTsNode": true
  }
}
